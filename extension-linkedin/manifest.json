{
  "manifest_version": 3,
  "name": "FLOW",
  "version": "0.9.6",
  "description": "FLOW: automatización de secuencias y tareas comerciales. Ejecuta en esta cuenta de LinkedIn las acciones que Nova programa, con topes diarios. Modo asistido por defecto.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "cookies",
    "sidePanel",
    "webRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://api.novacentrax.com/*",
    "https://app.novacentrax.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "FLOW · Secuencias y tareas",
    "default_popup": "sidepanel.html?p=1",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*"
      ],
      "js": [
        "content.js",
        "launcher.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://app.novacentrax.com/*"
      ],
      "js": [
        "puente.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["sidepanel.html", "sidepanel.js", "icons/*.png"], "matches": ["https://*.linkedin.com/*"] }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}