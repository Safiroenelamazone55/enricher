{
  "manifest_version": 3,
  "name": "Nova · Ventana de búsqueda",
  "version": "1.0.0",
  "description": "Reutiliza una sola ventana para las búsquedas (Google/IA) y los perfiles de LinkedIn que abres desde Nova, en vez de abrir una nueva cada vez.",
  "key": "",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://app.novacentrax.com/*"
    ]
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Nova · Ventana de búsqueda",
    "default_popup": "popup.html"
  }
}